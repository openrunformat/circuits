{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openrunformat/circuits/schema/circuit.schema.json",
  "title": "Open Run Format circuit registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["uid", "id", "name", "country", "location", "layouts", "provenance"],
  "properties": {
    "uid": { "$ref": "#/$defs/uid" },
    "id": { "$ref": "#/$defs/circuitId" },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/circuitId" } },
    "name": { "type": "string", "minLength": 1 },
    "names": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "website": { "type": "string", "minLength": 1 },
    "layouts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layout" } },
    "external": { "type": "array", "items": { "$ref": "#/$defs/external" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } }
  },
  "$defs": {
    "uid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "circuitId": { "type": "string", "pattern": "^[A-Z]{2}-[a-z0-9-]{2,32}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uid", "name", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
        "uid": { "$ref": "#/$defs/uid" },
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["cw", "ccw"] },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "finish"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2]))?$" },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "start": { "$ref": "#/$defs/gate" },
        "finish": { "$ref": "#/$defs/gate" },
        "splits": { "type": "array", "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "provenance"],
      "properties": {
        "line": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "provenance": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "id", "scope"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["circuit", "layout"] },
        "layout": { "type": "string" },
        "version": { "type": "string" },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "contributor", "date"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "method": { "enum": ["measured-gps", "orthophoto", "official"] },
        "source": { "type": "string", "minLength": 1 },
        "licence": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "contributor": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "notes": { "type": "string" }
      }
    }
  }
}
