{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openrunformat/circuits/schema/index.schema.json",
  "title": "Open Run Format circuit registry index (dist/index.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "source", "licence", "circuits"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "source": { "type": "string" },
    "licence": { "const": "CC0-1.0" },
    "circuits": { "type": "array", "items": { "$ref": "#/$defs/circuit" } }
  },
  "$defs": {
    "uid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "line": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uid", "aliases", "name", "names", "country", "location", "website", "layouts", "external", "attribution"],
      "properties": {
        "id": { "type": "string" },
        "uid": { "$ref": "#/$defs/uid" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } }
        },
        "website": { "type": ["string", "null"] },
        "layouts": { "type": "array", "items": { "$ref": "#/$defs/layout" } },
        "external": { "type": "array", "items": { "$ref": "#/$defs/external" } },
        "attribution": { "type": "array", "items": { "type": "string" } }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uid", "name", "direction", "versions"],
      "properties": {
        "id": { "type": "string" },
        "uid": { "$ref": "#/$defs/uid" },
        "name": { "type": "string" },
        "direction": { "enum": ["cw", "ccw", null] },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "length_m", "start", "finish", "splits"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "length_m": { "type": ["number", "null"] },
        "start": { "$ref": "#/$defs/line" },
        "finish": { "$ref": "#/$defs/line" },
        "splits": { "type": "array", "items": { "$ref": "#/$defs/line" } }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "id", "scope"],
      "properties": {
        "system": { "type": "string" },
        "id": { "type": "string" },
        "scope": { "enum": ["circuit", "layout"] },
        "layout": { "type": "string" },
        "version": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    }
  }
}
